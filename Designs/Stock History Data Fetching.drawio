                <mxCell id="iMzXw7-LtFSP-O9LAeiz-79" value="We are limited to maybe 80 requests a minute, but we can make those requests in batches of around 200 stocks. 200 stocks a minute per server, can get 18 months worth of data for 22000 stocks in about 20 min" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
